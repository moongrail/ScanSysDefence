<Application x:Class="ScanSysDefence.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Cyan"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BackgroundColor" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="SurfaceColor" Color="#252526"/>
            <SolidColorBrush x:Key="SurfaceVariantColor" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="BorderColor" Color="#3E3E42"/>
            <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryColor" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
            <SolidColorBrush x:Key="CriticalBrush" Color="#F14C4C"/>
            <SolidColorBrush x:Key="HighBrush" Color="#E86C00"/>
            <SolidColorBrush x:Key="MediumBrush" Color="#FFB900"/>
            <SolidColorBrush x:Key="LowBrush" Color="#107C10"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#0078D4"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>